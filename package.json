{
  "name": "data-viz-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Tableau-style drag-and-drop CSV visualization tool: Svelte 5 + ECharts, browser-only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "PERF=1 vitest run tests/perf",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "manifest": "python3 scripts/build_manifest.py"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": { "node": ">=20" }
}
